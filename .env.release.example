# Where `pnpm release:desktop` uploads the installer of the desktop app.
# Copy to `.env.release` (never committed) and fill in.

# SSH login of the server, as in `ssh user@host`.
DESKTOP_RELEASE_SSH=root@203.0.113.10
# Directory on the server that Caddy serves at /download (see docker-compose.prod.yml).
DESKTOP_RELEASE_DIR=/opt/frequencia/downloads
# Private key for that login; leave out to use the SSH defaults.
DESKTOP_RELEASE_KEY=
