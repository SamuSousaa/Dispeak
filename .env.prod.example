# Production configuration for docker-compose.prod.yml.
# Copy to .env.prod (ignored by git) and fill in every value.

# Public hostname. Caddy requests a Let's Encrypt certificate for it, so it must resolve to
# PUBLIC_IP. Without a domain of your own, <ip-with-dashes>.sslip.io works, e.g.
# 203-0-113-10.sslip.io.
DOMAIN=
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# Public IPv4 of the server, announced to browsers for media.
PUBLIC_IP=
# Private IPv4 of the server's network interface (on Oracle Cloud: `hostname -I`). Lets the
# TURN relay reach the SFU locally. Leave empty when the server has the public IP itself.
PRIVATE_IP=

# Secrets: generate each one with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
JWT_SECRET=
MEDIA_SHARED_SECRET=
TURN_SECRET=
# Optional: require `Authorization: Bearer <token>` on the API's /metrics.
METRICS_TOKEN=
# Optional: GIPHY API key (free at https://developers.giphy.com). Enables the GIF picker in the
# chat; without it the picker is hidden and nothing else changes.
GIPHY_API_KEY=

# mediasoup workers. One per CPU core is the rule; a 4-core VM gets 4.
MEDIA_NUM_WORKERS=2
LOG_LEVEL=info
