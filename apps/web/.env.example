# Dev-server proxy targets. The browser itself always uses same-origin /api and /media.
DEV_API_TARGET=http://localhost:4000
DEV_MEDIA_TARGET=http://localhost:4100

# Serve the dev server over HTTPS with a self-signed certificate. Required to use the
# microphone/camera from other LAN devices (https://<lan-ip>:5173).
# DEV_HTTPS=1
