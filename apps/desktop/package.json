{
  "name": "@frequencia/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Dispeaker para desktop",
  "author": "Dispeaker",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsup && electron .",
    "build": "tsup",
    "package": "tsup && electron-builder --win --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "org.dispeaker.desktop",
    "productName": "Dispeaker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "static/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Dispeaker-Setup-${version}.exe"
    }
  }
}
