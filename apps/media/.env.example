NODE_ENV=development
MEDIA_HOST=0.0.0.0
MEDIA_PORT=4100
LOG_LEVEL=info

# Number of mediasoup workers. Defaults to one per CPU core.
# MEDIA_NUM_WORKERS=4

# IP the RTC sockets bind to. Keep 0.0.0.0 unless the host has a dedicated media interface.
RTC_LISTEN_IP=0.0.0.0

# Addresses announced to browsers in ICE candidates, comma-separated.
#  - unset (native dev): 127.0.0.1 plus the first LAN IPv4 found, so localhost and LAN both work
#  - Docker dev:         127.0.0.1 (add the host LAN IP to reach it from other devices)
#  - production:         the public IP or DNS name of the server
# RTC_ANNOUNCED_ADDRESSES=127.0.0.1,192.168.0.10

# Each worker binds one UDP and one TCP port per announced address (mediasoup WebRtcServer).
# The range must hold workers x addresses ports and be open in the firewall for UDP and TCP.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
