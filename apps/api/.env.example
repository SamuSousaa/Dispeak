NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# --- data ------------------------------------------------------------------------------------
DATABASE_URL=postgres://frequencia:frequencia@localhost:5432/frequencia
# Connections kept open to Postgres, at most.
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
# Apply pending SQL migrations on startup.
RUN_MIGRATIONS=true

# --- auth ------------------------------------------------------------------------------------
# Signs access tokens. Required in production: generate with `openssl rand -hex 32`.
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Send the refresh cookie only over HTTPS. Defaults to true in production.
# COOKIE_SECURE=true

# --- media -----------------------------------------------------------------------------------
# Comma-separated STUN servers handed to browsers.
STUN_URLS=stun:stun.l.google.com:19302
# TURN servers (coturn) and the secret shared with it (`static-auth-secret`). When both are
# set, browsers receive time-limited TURN credentials.
# TURN_URLS=turn:example.com:3478?transport=udp,turn:example.com:3478?transport=tcp
# TURN_SECRET=
TURN_TTL_SECONDS=3600
# Secret shared between the API and the media service (voice tokens, internal RPC).
# Required in production: generate with `openssl rand -hex 32`. Must match in both services.
# MEDIA_SHARED_SECRET=
# Internal WebSocket endpoint of the media service (never exposed publicly).
MEDIA_INTERNAL_URL=ws://localhost:4100/media/internal
# Lifetime of the token that lets a browser connect to a voice channel.
VOICE_TOKEN_TTL_SECONDS=60

# --- limits ----------------------------------------------------------------------------------
# Requests per minute per client address, and the stricter limit for /auth endpoints.
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
# Messages per minute a single user may send.
RATE_LIMIT_MESSAGES_MAX=60
# Attachments per minute a single user may upload.
RATE_LIMIT_UPLOADS_MAX=30
# Link previews and GIF searches per minute a single user may ask for.
RATE_LIMIT_UNFURL_MAX=60
# Where chat attachments (images) are stored. Use a persistent path in production.
UPLOADS_DIR=.dev/uploads
GATEWAY_HEARTBEAT_MS=30000
# How long a dropped gateway session can still be resumed.
GATEWAY_RESUME_WINDOW_MS=60000
# Gateway frames a connection may send per 10 seconds.
GATEWAY_RATE_LIMIT=60

# --- chat extras -----------------------------------------------------------------------------
# Fetch the title and picture of links posted in the chat (the server makes the request).
LINK_PREVIEWS=true
# GIF picker, through GIPHY. Free key at https://developers.giphy.com — without it the picker
# is hidden. This is the only feature that depends on an outside service.
# GIPHY_API_KEY=

# Nickname-only lab routes (/lab/*). Defaults to true outside production.
# LAB_ENABLED=true

# --- observability ---------------------------------------------------------------------------
# Prometheus metrics are served at /metrics (not under /api). When this token is set, the
# endpoint requires `Authorization: Bearer <token>`.
# METRICS_TOKEN=
