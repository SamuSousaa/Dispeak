{
  "name": "@frequencia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.3",
    "@frequencia/shared": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
